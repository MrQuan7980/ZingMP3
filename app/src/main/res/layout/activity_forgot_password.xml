<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@drawable/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".authen.ForgotPassword">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/text_zing_mp3"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="7dp"
            android:layout_marginStart="7dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:text="@string/app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/createAccount"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="7dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="@string/create_account"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/viewInputEmail"
            android:layout_marginTop="190dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/text_zing_mp3"
            android:layout_width="match_parent"
            android:layout_height="400dp">

            <FrameLayout
                android:id="@+id/fingerprint"
                android:layout_marginBottom="10dp"
                android:padding="4dp"
                android:background="@drawable/background_view_frame"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="55dp"
                android:layout_height="55dp">
                <ImageView
                    android:importantForAccessibility="no"
                    android:src="@drawable/img"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>

            <TextView
                android:id="@+id/titleForgot"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="23sp"
                android:layout_marginTop="5dp"
                android:text="@string/title_forgot_password"
                app:layout_constraintTop_toBottomOf="@+id/fingerprint"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/text"
                android:layout_marginTop="4dp"
                android:textColor="@color/light_gray"
                android:textSize="14sp"
                android:text="@string/text_forgot_password"
                app:layout_constraintTop_toBottomOf="@id/titleForgot"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            
            <TextView
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="14sp"
                android:text="@string/email"
                android:layout_marginStart="15dp"
                android:layout_marginBottom="5dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/inputEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            
            <EditText
                android:id="@+id/inputEmail"
                android:autofillHints=""
                android:hint="@string/enter_email"
                android:inputType="textEmailAddress"
                android:textSize="16.dp"
                android:textColor="@color/black"
                android:textColorHint="@color/white"
                android:drawableEnd="@drawable/round_email_24"
                android:drawableTint="@color/white"
                android:drawablePadding="10dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginTop="40dp"
                android:background="@drawable/input"
                android:alpha="0.9"
                app:layout_constraintTop_toBottomOf="@id/text"
                tools:ignore="TextFields" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintButtonSentEmail"
                app:layout_constraintTop_toBottomOf="@id/inputEmail"
                android:layout_marginTop="40dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/buttonForgot"
                    android:text="@string/button"
                    android:textSize="16.dp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:textAllCaps="false"
                    android:background="@drawable/button"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:alpha="0.9"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <ProgressBar
                    android:id="@+id/progressbarForgot"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_width="35dp"
                    android:layout_height="35dp"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
            

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/view_otp"
            android:visibility="gone"
            android:layout_marginTop="190dp"
            app:layout_constraintTop_toBottomOf="@id/text_zing_mp3"
            android:layout_width="match_parent"
            android:layout_height="400dp">

            <FrameLayout
                android:id="@+id/fragment_otp"
                android:layout_marginBottom="10dp"
                android:padding="4dp"
                android:background="@drawable/background_view_frame"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="55dp"
                android:layout_height="55dp">
                <ImageView
                    android:src="@drawable/paper"
                    android:importantForAccessibility="no"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>

            <TextView
                android:id="@+id/titleResetPassword"
                android:textStyle="bold"
                android:layout_marginTop="5dp"
                android:textColor="@color/white"
                android:textSize="23sp"
                android:text="@string/title_forgot_password"
                app:layout_constraintTop_toBottomOf="@+id/fragment_otp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:id="@+id/linearSentCode"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:layout_marginTop="7dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleResetPassword"
                android:layout_width="match_parent"
                android:layout_height="30dp">

                <TextView
                    android:textColor="@color/light_gray"
                    android:textSize="13sp"
                    android:text="@string/we_sent_code_to"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:id="@+id/emailSent"
                    android:textStyle="bold"
                    android:layout_marginStart="3dp"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/linear_otp"
                android:layout_marginTop="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/linearSentCode"
                android:layout_width="400dp"
                android:layout_height="58dp">

                <EditText
                    android:id="@+id/numberOne"
                    android:layout_weight="1"
                    android:autofillHints=""
                    android:maxLines="1"
                    android:inputType="number"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:textStyle="bold"
                    android:textSize="13.sp"
                    android:gravity="center"
                    android:textColor="@color/black"
                    android:background="@drawable/background_view_frame"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="7dp"
                    android:layout_width="50dp"
                    android:layout_height="50dp"/>

                <ImageView
                    android:id="@+id/imageOvalOne"
                    android:visibility="gone"
                    android:background="@drawable/oval"
                    android:layout_marginStart="35dp"
                    android:importantForAccessibility="no"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_width="20dp"
                    android:layout_height="20dp"/>


                <EditText
                    android:id="@+id/numberTwo"
                    android:maxLines="1"
                    android:autofillHints=""
                    android:inputType="number"
                    android:textSize="13.sp"
                    android:gravity="center"
                    android:textColor="@color/black"
                    android:layout_weight="1"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/numberOne"
                    android:background="@drawable/background_view_frame"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="7dp"
                    android:layout_width="50dp"
                    android:layout_height="50dp"/>

                <ImageView
                    android:id="@+id/imageOvalTwo"
                    android:visibility="gone"
                    android:background="@drawable/oval"
                    android:layout_marginStart="97dp"
                    android:importantForAccessibility="no"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_width="20dp"
                    android:layout_height="20dp"/>

                <EditText
                    android:id="@+id/numberThree"
                    android:maxLines="1"
                    android:autofillHints=""
                    android:inputType="number"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/numberTwo"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:textColor="@color/black"
                    android:layout_weight="1"
                    android:background="@drawable/background_view_frame"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="7dp"
                    android:layout_width="50dp"
                    android:layout_height="50dp"/>

                <ImageView
                    android:id="@+id/imageOvalThree"
                    android:visibility="gone"
                    android:importantForAccessibility="no"
                    android:background="@drawable/oval"
                    android:layout_marginStart="160dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_width="20dp"
                    android:layout_height="20dp"/>

                <EditText
                    android:id="@+id/numberFour"
                    android:maxLines="1"
                    android:autofillHints=""
                    android:textSize="13.sp"
                    android:inputType="number"
                    android:gravity="center"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/numberThree"
                    android:textColor="@color/black"
                    android:layout_weight="1"
                    android:background="@drawable/background_view_frame"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="7dp"
                    android:layout_width="50dp"
                    android:layout_height="50dp"/>

                <ImageView
                    android:id="@+id/imageOvalFour"
                    android:visibility="gone"
                    android:background="@drawable/oval"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="221dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_width="20dp"
                    android:layout_height="20dp"/>

                <EditText
                    android:id="@+id/numberFive"
                    android:maxLines="1"
                    android:autofillHints=""
                    android:inputType="number"
                    android:textSize="13.sp"
                    android:gravity="center"
                    android:textColor="@color/black"
                    android:layout_weight="1"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/numberFour"
                    android:background="@drawable/background_view_frame"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="7dp"
                    android:layout_width="50dp"
                    android:layout_height="50dp"/>

                <ImageView
                    android:id="@+id/imageOvalFive"
                    android:visibility="gone"
                    android:importantForAccessibility="no"
                    android:background="@drawable/oval"
                    android:layout_marginStart="284dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_width="20dp"
                    android:layout_height="20dp"/>

                <EditText
                    android:id="@+id/numberSix"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:autofillHints=""
                    android:inputType="number"
                    android:textSize="13sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/numberFive"
                    android:gravity="center"
                    android:textColor="@color/black"
                    android:background="@drawable/background_view_frame"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="7dp"
                    android:layout_width="50dp"
                    android:layout_height="50dp"/>

                <ImageView
                    android:id="@+id/imageOvalSix"
                    android:visibility="gone"
                    android:importantForAccessibility="no"
                    android:background="@drawable/oval"
                    android:layout_marginStart="345dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_width="21dp"
                    android:layout_height="21dp"/>


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonOTP"
                android:text="@string/otp"
                android:textSize="16.dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:background="@drawable/button"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:alpha="0.9"
                android:layout_marginTop="45dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/linear_otp"/>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_marginTop="30dp"
                android:gravity="center_horizontal"
                app:layout_constraintTop_toBottomOf="@id/buttonOTP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="@string/text_resent_otp"
                    android:textColor="@color/gray"
                    android:textSize="13sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="25dp"
                    app:layout_constraintBottom_toTopOf="@id/buttonOTP"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/resend_otp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginStart="3dp"
                    android:text="@string/resent_otp"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="25dp"
                    app:layout_constraintBottom_toTopOf="@id/buttonOTP"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/viewChangePassword"
            android:visibility="gone"
            android:layout_marginTop="190dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/text_zing_mp3"
            android:layout_width="match_parent"
            android:layout_height="410dp">

            <FrameLayout
                android:id="@+id/imageSecurity"
                android:layout_marginBottom="10dp"
                android:padding="6dp"
                android:background="@drawable/background_view_frame"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="55dp"
                android:layout_height="55dp">
                <ImageView
                    android:importantForAccessibility="no"
                    android:src="@drawable/img_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>

            <TextView
                android:id="@+id/titleForgotPassword"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="23sp"
                android:layout_marginTop="5dp"
                android:text="@string/title_set_password"
                app:layout_constraintTop_toBottomOf="@+id/imageSecurity"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/textPassword"
                android:layout_marginTop="4dp"
                android:textColor="@color/light_gray"
                android:textSize="14sp"
                android:text="@string/text_set_password"
                app:layout_constraintTop_toBottomOf="@id/titleForgotPassword"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="14sp"
                android:text="@string/email"
                android:layout_marginStart="15dp"
                android:layout_marginBottom="5dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/inputPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/inputPassword"
                android:autofillHints=""
                android:hint="@string/input_password"
                android:inputType="textPassword"
                android:textSize="16.dp"
                android:textColor="@color/black"
                android:textColorHint="@color/white"
                android:drawableTint="@color/white"
                android:drawablePadding="10dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginTop="40dp"
                android:background="@drawable/input"
                android:alpha="0.9"
                app:layout_constraintTop_toBottomOf="@id/textPassword"
                tools:ignore="TextFields" />

            <TextView
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="14sp"
                android:text="@string/confirm_password"
                android:layout_marginStart="15dp"
                android:layout_marginBottom="5dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/inputConfirmPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/inputConfirmPassword"
                android:autofillHints=""
                android:hint="@string/input_confirm_password"
                android:inputType="textPassword"
                android:textSize="16.dp"
                android:textColor="@color/black"
                android:textColorHint="@color/white"
                android:drawableEnd="@drawable/icon_eye"
                android:drawableTint="@color/white"
                android:drawablePadding="10dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginTop="35dp"
                android:background="@drawable/input"
                android:alpha="0.9"
                app:layout_constraintTop_toBottomOf="@id/inputPassword"
                tools:ignore="TextFields" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintButtonForgotPassword"
                app:layout_constraintTop_toBottomOf="@id/inputConfirmPassword"
                android:layout_marginTop="40dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/buttonForgotPassword"
                    android:text="@string/button"
                    android:textSize="16.dp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:textAllCaps="false"
                    android:background="@drawable/button"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:alpha="0.9"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <ProgressBar
                    android:id="@+id/progressbarForgotPassword"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_width="35dp"
                    android:layout_height="35dp"/>

            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="790dp"
            app:layout_constraintTop_toTopOf="parent"
            tools:layout_editor_absoluteX="0dp">

            <View
                android:id="@+id/showEnterEmail"
                android:layout_width="90dp"
                android:layout_height="5dp"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/background_view_otp"
                app:layout_constraintBottom_toTopOf="@id/backSignIn"
                app:layout_constraintStart_toStartOf="parent" />

            <View
                android:id="@+id/notShowEnterEmail"
                android:visibility="gone"
                android:layout_width="90dp"
                android:layout_height="5dp"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/background_view_otp_2"
                app:layout_constraintBottom_toTopOf="@id/backSignIn"
                app:layout_constraintStart_toStartOf="parent" />

            <View
                android:id="@+id/viewEnterOTP"
                android:visibility="gone"
                android:layout_width="90dp"
                android:layout_height="5dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/background_view_otp"
                app:layout_constraintBottom_toTopOf="@id/backSignIn"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <View
                android:id="@+id/notEnterOTP"
                android:layout_width="90dp"
                android:layout_height="5dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/background_view_otp_2"
                app:layout_constraintBottom_toTopOf="@id/backSignIn"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <View
                android:id="@+id/viewShowForgotPassword"
                android:visibility="gone"
                android:layout_width="90dp"
                android:layout_height="5dp"
                android:layout_marginEnd="40dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/background_view_otp"
                app:layout_constraintBottom_toTopOf="@id/backSignIn"
                app:layout_constraintEnd_toEndOf="parent" />

            <View
                android:id="@+id/notShowForgotPassword"
                android:layout_width="90dp"
                android:layout_height="5dp"
                android:layout_marginEnd="40dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/background_view_otp_2"
                app:layout_constraintBottom_toTopOf="@id/backSignIn"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/backSignIn"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/icon_back"
                    app:tint="@color/gray" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/back_login"
                    android:textColor="@color/gray" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>